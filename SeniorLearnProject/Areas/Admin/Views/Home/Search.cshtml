@using Microsoft.AspNetCore.Identity
@using SeniorLearnProject.Areas.Admin.Models;

@{
    ViewData["Title"] = "Home Page";
    string userInfo = "";
}
@model List<UserModel>
<div class="text-center">
    <form method="post" asp-controller="Home" asp-action="Search">
        <input type="text" name="name" placeholder="Enter name"/>
        <button type="submit">Search</button>
    </form>
</div>
@if (Model != null){
<div>
    <table class="table">
        @foreach(var u in Model){
        @if(u.MemberId == null){
            userInfo = "No Member";
        }
        for(int i = 0; i < u.RoleBools.Length; i++){
            bool thisRole = u.RoleBools[i];
            string thisString = u.RoleStrings[i];
            if(!thisRole) continue;
            userInfo = thisString;
            if(thisString == "Admin") break;
        }
        <tr>
            <th>
                <p>@u.Email</p>
            </th>
            <th>
                <p>@userInfo</p>
            </th>
            <th>
                <form method ="get" asp-controller="Home" asp-action="Details">
                    <input type="hidden" name="id" value="@u.Id"/>
                    <button type="submit">View Details</button>
                </form>
            </th>
        </tr>
        }
    </table>
</div>
}
