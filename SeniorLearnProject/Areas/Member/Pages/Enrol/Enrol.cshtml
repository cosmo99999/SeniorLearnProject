@page "{id:int}"

@model SeniorLearnProject.Areas.Member.Pages.Enrol.EnrolModel
@{
    ViewData["Title"] = "Enrol";
}

<h1>Enrol</h1>
@* form for a course *@
@{
    if (Model.IsCourse == true)
    {
        <div class="alert alert-info">
            This lesson is part of a course. Enrolling will enroll you in all lessons within the course.
        </div>

        <form method="post">
            <input type="hidden" asp-for="LessonId" />
            <input type="hidden" asp-for="MemberId" />
            <div class="mb-3">
                <label asp-for="Title" class="form-label">Course</label>
                <input asp-for="Title" class="form-control" readonly />
            </div>
            <div class="mb-3">
                <label asp-for="StartDate" class="form-label">Start Date</label>
                <input asp-for="StartDate" class="form-control" readonly />
            </div>
            <div class="mb-3">
                <label asp-for="FinishDate" class="form-label">Finish Date</label>
                <input asp-for="FinishDate" class="form-control" readonly />
            </div>
            <div class="mb-3">
                <label asp-for="WeekDays" class="form-label">Week Days</label>
                <input asp-for="WeekDays" class="form-control" readonly />
            </div>
            <div class="mb-3">
                <label asp-for="StartTime" class="form-label">Start Time</label>
                <input asp-for="StartTime" class="form-control" readonly />
            </div>
            <div class="col-12 d-flex gap-2 justify-content-end">
                <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Enrol</button>
            </div>
        </form>
    }
}

@* form for a single lesson *@
@{
    if (Model.IsCourse == false)
    {
        <div class="alert alert-info">
            You are enrolling in a single lesson. You can view other lessons in the same course on the lesson details page.
        </div>

        <form method="post">
            <input type="hidden" asp-for="LessonId" />
            <input type="hidden" asp-for="MemberId" />
            <div class="mb-3">
                <label asp-for="Title" class="form-label">Lesson</label>
                <input asp-for="Title" class="form-control" readonly />
            </div>
            <div class="mb-3">
                <label asp-for="StartTime" class="form-label">Time</label>
                <input asp-for="StartTime" class="form-control" readonly />
            </div>
            <div class="mb-3">
                <label asp-for="StartDate" class="form-label">Date</label>
                <input asp-for="StartDate" class="form-control" readonly />
            </div>
            <div class="col-12 d-flex gap-2 justify-content-end">
                <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Enrol</button>
            </div>
        </form>
    }
}

