@page
@model SeniorLearnProject.Areas.Member.Pages.Enrol.IndexModel
@{
    ViewData["Title"] = "Enrol";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="display-5 text-dark fw-bold m-0">Enrol</h1>
            <p class="text-muted m-0 fs-5">Find and manage your lessons</p>
        </div>
    </div>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">


        @foreach (var lesson in Model.Lessons)
        {
            <div class="col">
                <div class="card h-100 ticket-card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="card-header bg-white border-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                        @{
                            bool isEnrolled = Model.Enrolments?.Any(e => e.Lesson.Id == lesson.Id) ?? false;
                        }
                        @if (isEnrolled)
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="green" class="bi bi-check-circle-fill" viewBox="0 0 16 16" title="Enrolled">
                                <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0m-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z" />
                            </svg>
                        }
                        <span class="badge status-badge status-@lesson.DeliveryPlan.MemberId">@lesson.DeliveryPlan.MemberId</span>
                        <small class="text-muted fw-medium">#@lesson.Id.ToString("D4")</small>
                        @if (lesson.DeliveryPlan?.IsCourse == true)
                        {
                            <!-- Course icon: mortarboard -->
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-mortarboard-fill" viewBox="0 0 16 16">
                                <path d="m.5 3 .04.87a2 2 0 0 0-.342 1.311l.637 7A2 2 0 0 0 2.826 14H9v-1H2.826a1 1 0 0 1-.995-.91l-.637-7A1 1 0 0 1 2.19 4h11.62a1 1 0 0 1 .996 1.09L14.54 8h1.005l.256-2.819A2 2 0 0 0 13.81 3H9.828a2 2 0 0 1-1.414-.586l-.828-.828A2 2 0 0 0 6.172 1H2.5a2 2 0 0 0-2 2m5.672-1a1 1 0 0 1 .707.293L7.586 3H2.19q-.362.002-.683.12L1.5 2.98a1 1 0 0 1 1-.98z" />
                                <path d="M15.854 10.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.707 0l-1.5-1.5a.5.5 0 0 1 .707-.708l1.146 1.147 2.646-2.647a.5.5 0 0 1 .708 0" />
                            </svg>
                        }
                        else
                        {
                            <!-- Default: book icon -->
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-book-half" viewBox="0 0 16 16">
                                <path d="M5 4a.5.5 0 0 0 0 1h6a.5.5 0 0 0 0-1zm-.5 2.5A.5.5 0 0 1 5 6h6a.5.5 0 0 1 0 1H5a.5.5 0 0 1-.5-.5M5 8a.5.5 0 0 0 0 1h6a.5.5 0 0 0 0-1zm0 2a.5.5 0 0 0 0 1h3a.5.5 0 0 0 0-1z" />
                                <path d="M2 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2zm10-1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1" />
                            </svg>
                        }
                    </div>
                    <div class="card-body">
                        <h5 class="card-title fw-bold text-dark mb-1">@lesson.Title</h5>
                        <div class="d-flex align-items-center text-muted small">

                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-calendar-event me-2" viewBox="0 0 16 16">
                                <path d="M11 6.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-1z" />
                                <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5zM1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4H1z" />
                            </svg>

                            @lesson.Start.ToString("MMM dd, yyyy HH:mm")
                        </div>

                        @if (!isEnrolled)
                        {
                            <div class="card-footer bg-white border-0 d-flex justify-content-end gap-2 py-3">
                                <a asp-page="./Enrol" asp-route-id="@lesson.Id" class="btn btn-sm btn-outline-primary d-flex align-items-center">
                                    Enrol
                                </a>
                            </div>
                        }
                        @if (isEnrolled)
                        {
                            
                            <div class="card-footer bg-white border-0 d-flex justify-content-end gap-2 py-3">
                                <a asp-page="./Cancel"
                                   asp-route-id="@Model.getEnrolmentId(lesson)"
                                   class="btn btn-sm btn-outline-primary d-flex align-items-center">
                                    Cancel
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>
