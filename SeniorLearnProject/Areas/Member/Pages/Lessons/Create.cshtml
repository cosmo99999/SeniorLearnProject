@page
@model SeniorLearnProject.Areas.Member.Pages.Lessons.CreateModel
@{
    ViewData["Title"] = "Create Lesson";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="d-flex align-items-center gap-2 mb-4">
                <a asp-page="./Index" class="btn btn-outline-secondary btn-sm rounded-circle p-2 d-inline-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-arrow-left" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"/>
                    </svg>
                </a>
                <h1 class="h2 m-0 text-dark fw-bold">Create Lesson</h1>
            </div>

            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4 p-md-5">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

                        <div class="mb-4">
                            <label asp-for="Input.Title" class="form-label fw-semibold text-secondary"></label>
                            <input asp-for="Input.Title" class="form-control border-start-0 bg-light" placeholder="e.g. Intro to Advanced C#" />
                            <span asp-validation-for="Input.Title" class="text-danger mt-1 d-block small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Input.StartDate" class="form-label fw-semibold text-secondary">Date</label>
                                <input asp-for="Input.StartDate" type="date" class="form-control bg-light" />
                                <span asp-validation-for="Input.StartDate" class="text-danger mt-1 d-block small"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Input.StartTime" class="form-label fw-semibold text-secondary">Start Time</label>
                                <input asp-for="Input.StartTime" type="time" class="form-control bg-light" />
                                <span asp-validation-for="Input.StartTime" class="text-danger mt-1 d-block small"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Input.EndTime" class="form-label fw-semibold text-secondary">End Time</label>
                                <input asp-for="Input.EndTime" type="time" class="form-control bg-light" />
                                <span asp-validation-for="Input.EndTime" class="text-danger mt-1 d-block small"></span>
                            </div>
                        </div>

                        <div class="form-check form-switch mb-3">
                            <input asp-for="Input.IsCourse" class="form-check-input" id="isCourseToggle" />
                            <label class="form-check-label" for="isCourseToggle">Create as Course</label>
                        </div>

                        <div id="courseOptions" style="display:none;">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Input.CourseEndDate" class="form-label fw-semibold text-secondary">Course End Date</label>
                                    <input asp-for="Input.CourseEndDate" type="date" class="form-control bg-light" />
                                    <span asp-validation-for="Input.CourseEndDate" class="text-danger mt-1 d-block small"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold text-secondary">Weekdays</label>
                                    <div class="d-flex gap-2 flex-wrap">
                                        <div class="form-check">
                                            <input asp-for="Input.Monday" class="form-check-input" />
                                            <label class="form-check-label">Mon</label>
                                        </div>
                                        <div class="form-check">
                                            <input asp-for="Input.Tuesday" class="form-check-input" />
                                            <label class="form-check-label">Tue</label>
                                        </div>
                                        <div class="form-check">
                                            <input asp-for="Input.Wednesday" class="form-check-input" />
                                            <label class="form-check-label">Wed</label>
                                        </div>
                                        <div class="form-check">
                                            <input asp-for="Input.Thursday" class="form-check-input" />
                                            <label class="form-check-label">Thu</label>
                                        </div>
                                        <div class="form-check">
                                            <input asp-for="Input.Friday" class="form-check-input" />
                                            <label class="form-check-label">Fri</label>
                                        </div>
                                        <div class="form-check">
                                            <input asp-for="Input.Saturday" class="form-check-input" />
                                            <label class="form-check-label">Sat</label>
                                        </div>
                                        <div class="form-check">
                                            <input asp-for="Input.Sunday" class="form-check-input" />
                                            <label class="form-check-label">Sun</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-grid mt-2">
                            <button type="submit" class="btn btn-primary btn-lg shadow-sm rounded-3 py-2.5 fw-bold d-flex align-items-center justify-content-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-check-circle-fill" viewBox="0 0 16 16">
                                    <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0m-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                                </svg>
                                Create
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function(){
            var toggle = document.getElementById('isCourseToggle');
            var options = document.getElementById('courseOptions');
            if (!toggle) return;
            function setVisibility(){
                if (toggle.checked) options.style.display = '';
                else options.style.display = 'none';
            }
            toggle.addEventListener('change', setVisibility);
            // init
            setVisibility();
        })();
    </script>
}