@page "{id:int}"
@model SeniorLearnProject.Areas.Member.Pages.Lessons.DeleteModel
@{
    ViewData["Title"] = "Delete Lesson";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="d-flex align-items-center gap-2 mb-4">
                <a asp-page="./Index" class="btn btn-outline-secondary btn-sm rounded-circle p-2 d-inline-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-arrow-left" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"/>
                    </svg>
                </a>
                <h1 class="h2 m-0 text-dark fw-bold">Delete Lesson</h1>
            </div>

            <div class="card border-0 shadow-sm rounded-4 border-start border-danger border-5">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4 text-danger">
                        <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" fill="currentColor" class="bi bi-exclamation-triangle-fill" viewBox="0 0 16 16">
                            <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5m.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2"/>
                        </svg>
                        <h3 class="fw-bold text-dark mt-3">Are you sure?</h3>
                        <p class="text-muted">This action is permanent and cannot be undone.</p>
                    </div>

                    <div class="bg-light p-4 rounded-4 mb-4">
                        <div class="mb-3">
                            <span class="text-secondary small fw-semibold text-uppercase d-block mb-1">Lesson Title</span>
                            <span class="fs-5 fw-bold text-dark">@Model.Lesson.Title</span>
                        </div>
                        <div class="row">
                            <div class="col-6">
                                <span class="text-secondary small fw-semibold text-uppercase d-block mb-1">Start Time</span>
                                <span class="text-dark fw-medium">@Model.Lesson.Start.ToString("MMM dd, yyyy HH:mm")</span>
                            </div>
                            <div class="col-6">
                                <span class="text-secondary small fw-semibold text-uppercase d-block mb-1">End Time</span>
                                <span class="text-dark fw-medium">@Model.Lesson.End.ToString("MMM dd, yyyy HH:mm")</span>
                            </div>
                        </div>
                    </div>

                    <form method="post">
                        <div class="row g-3">
                            <div class="col-6">
                                <a asp-page="./Index" class="btn btn-light btn-lg w-100 rounded-3 py-2.5 fw-semibold border text-secondary">
                                    Cancel
                                </a>
                            </div>
                            <div class="col-6">
                                <button type="submit" class="btn btn-danger btn-lg w-100 rounded-3 py-2.5 fw-bold d-flex align-items-center justify-content-center gap-2 shadow-sm">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-trash3-fill" viewBox="0 0 16 16">
                                        <path d="M11 1.5v1h3.5a.5.5 0 0 1 0 1h-.538l-.853 10.66A2 2 0 0 1 11.115 16H4.885a2 2 0 0 1-1.993-1.84L2.038 3.5H1.5a.5.5 0 0 1 0-1H5v-1A1.5 1.5 0 0 1 6.5 0h3A1.5 1.5 0 0 1 11 1.5m-5 0v1h4v-1a.5.5 0 0 0-.5-.5h-3a.5.5 0 0 0-.5.5M4.5 5.029l.5 8.5a.5.5 0 1 0 .998-.06l-.5-8.5a.5.5 0 1 0-.998.06m6.53-.185a.5.5 0 0 0-.584.456l-.5 8.5a.5.5 0 0 0 .998.06l.5-8.5a.5.5 0 0 0-.414-.476q-.504.004-.998 0m-4.017-.18a.5.5 0 0 0-.456.584l.5 8.5A.5.5 0 0 0 7.98 13l-.5-8.5a.5.5 0 0 0-.48-.476z"/>
                                    </svg>
                                    Delete Lesson
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
