@using SeniorLearnProject.Models
@model Enrolment

@{
    ViewData["Title"] = "Lesson Details";
}

<a asp-action="Index" class="btn btn-outline-secondary mb-4">&larr; Back to Dashboard</a>

<div class="card shadow-sm">
    <div class="card-header">
        <h4 class="mb-0">@Model.Lesson.Title</h4>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Member</dt>
            <dd class="col-sm-9">@Model.Member.FirstName @Model.Member.LastName</dd>

            <dt class="col-sm-3">Start</dt>
            <dd class="col-sm-9">@Model.Lesson.Start.ToString("dddd, dd MMM yyyy 'at' h:mm tt")</dd>

            <dt class="col-sm-3">End</dt>
            <dd class="col-sm-9">@Model.Lesson.End.ToString("dddd, dd MMM yyyy 'at' h:mm tt")</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                @if (Model.Lesson.End > DateTime.Now)
                {
                    <span class="badge bg-success">Upcoming</span>
                }
                else
                {
                    <span class="badge bg-secondary">Completed</span>
                }
            </dd>
        </dl>
    </div>
</div>
